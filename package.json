{
  "name": "@fastybird/smart-panel",
  "private": true,
  "version": "0.7.0-alpha.1",
  "description": "Repository for FastyBird Smart Panel packages development",
  "keywords": [
    "fastybird",
    "fb",
    "ui",
    "smart-panel",
    "vue"
  ],
  "homepage": "https://smart-panel.fastybird.com",
  "bugs": "https://github.com/FastyBird/smart-panel/issues",
  "license": "Apache-2.0",
  "author": {
    "name": "Studio81 Labs s.r.o.",
    "email": "dev@studio81.cz",
    "url": "https://www.studio81.cz"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/FastyBird/smart-panel.git"
  },
  "scripts": {
    "start": "pnpm run -r start",
    "start:dev": "pnpm run -r start:dev",
    "start:debug": "pnpm run -r start:debug",
    "start:prod": "pnpm run -r start:prod",
    "build": "pnpm run -r build",
    "clean": "pnpm run -r clean && rm -rf node_modules",
    "fix": "pnpm run -r fix",
    "graph": "nx graph",
    "lint:js": "pnpm run -r lint:js",
    "lint:js:fix": "pnpm run -r lint:js:fix",
    "lint:styles": "pnpm run -r lint:styles",
    "pretty": "pnpm run -r pretty:write && pnpm run -r pretty:check",
    "pretty:check": "pnpm run -r pretty:check",
    "pretty:write": "pnpm run -r pretty:write",
    "test:unit": "pnpm run -r test:unit",
    "test:watch": "pnpm run -r test:watch",
    "test:cov": "pnpm run -r test:cov",
    "test:debug": "pnpm run -r test:debug",
    "test:e2e": "pnpm run -r test:e2e",
    "generate:all": "pnpm run generate:spec && pnpm run generate:openapi && pnpm run generate:docs",
    "generate:openapi": "pnpm --filter @fastybird/smart-panel-backend run generate:openapi && pnpm --filter @fastybird/smart-panel-admin run generate:openapi",
    "generate:spec": "pnpm run -r generate:spec",
    "generate:docs": "pnpm --filter @fastybird/smart-panel-website run generate:docs",
    "bootstrap": "pnpm install && pnpm run generate:spec && pnpm --filter @fastybird/smart-panel-extension-sdk build && pnpm --filter @fastybird/smart-panel-extension-example build && pnpm run generate:openapi && pnpm --filter @fastybird/smart-panel-backend run typeorm:migration:run && pnpm --filter @fastybird/smart-panel-backend run build && pnpm --filter @fastybird/smart-panel-admin run build",
    "onboard": "pnpm --filter @fastybird/smart-panel-backend run cli:prod auth:onboarding",
    "admin:extensions": "pnpm --filter @fastybird/smart-panel-backend run cli:prod config:generate-admin-extensions",
    "admin:build": "pnpm --filter @fastybird/smart-panel-admin build",
    "admin:postinstall": "node -e \"process.exit(process.env.FB_NO_ADMIN_BUILD ? 0 : 1)\" || pnpm run admin:extensions && pnpm run admin:build",
    "testing:dev": "pnpm --filter @fastybird/smart-panel-testing start:dev",
    "testing:build": "pnpm --filter @fastybird/smart-panel-testing build"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "pnpm": {
    "overrides": {
      "@babel/core": "^7.29.6",
      "@babel/traverse": "~7.27.7",
      "@eslint/plugin-kit": "^0.3.4",
      "@nestjs/core": "^11.1.18",
      "@nestjs/platform-fastify": "^11.1.24",
      "@nestjs/swagger": "11.2.6",
      "@protobufjs/utf8": "^1.1.1",
      "@tootallnate/once": "^3.0.1",
      "@types/node": "^24.12.0",
      "@xhmikosr/decompress": "^11.1.3",
      "@xmldom/xmldom": "^0.9.10",
      "ajv@8": "^8.18.0",
      "axios": "^1.18.0",
      "body-parser": "^2.3.0",
      "brace-expansion@1": "^1.1.18",
      "brace-expansion@2": "^2.1.4",
      "brace-expansion@5": "^5.0.9",
      "braces": "^3.0.3",
      "cookie": "^0.7.0",
      "cross-spawn": "^7.0.6",
      "debug": "^4.4.1",
      "defu": "^6.1.5",
      "diff": "^4.0.4",
      "dompurify": "^3.4.12",
      "engine.io": "^6.6.7",
      "esbuild": "^0.25.5",
      "fast-uri": "^3.1.4",
      "fastify": "^5.8.5",
      "file-type@21": "^21.3.2",
      "find-my-way": "^9.7.0",
      "flatted": "^3.4.2",
      "follow-redirects": "^1.16.0",
      "form-data": "^4.0.6",
      "handlebars": "^4.7.9",
      "http-proxy-middleware": "^3.0.5",
      "immutable": "^5.1.8",
      "ip": "^2.0.1",
      "ip-address": "^10.1.1",
      "joi": "^18.2.1",
      "jose": "^6.0.11",
      "js-cookie": "^3.0.7",
      "js-yaml": "^4.3.0",
      "jws": "^4.0.1",
      "lodash": "^4.18.0",
      "lodash-es": "^4.18.0",
      "mdast-util-to-hast": "^13.2.1",
      "mermaid": "^11.15.0",
      "micromatch": "^4.0.8",
      "minimatch@3": "^3.1.4",
      "minimatch@9": "^9.0.7",
      "multer": "^2.2.0",
      "music-metadata": "^11.12.3",
      "nanoid": "^3.3.8",
      "next": "^15.5.21",
      "on-headers": "^1.1.0",
      "path-to-regexp": "^8.4.0",
      "picomatch@2": "^2.3.2",
      "picomatch@4": "^4.0.4",
      "piscina": "^4.9.3",
      "postcss": "^8.5.10",
      "protobufjs@7": "^7.6.5",
      "qs": "^6.15.2",
      "rollup@2": "^2.80.0",
      "secp256k1": "^5.0.1",
      "sharp": "^0.35.0",
      "shell-quote": "^1.9.0",
      "socket.io-parser": "^4.2.6",
      "svgo": "^3.3.4",
      "systeminformation": "^5.31.7",
      "tar": "^7.5.21",
      "tar-fs": "^3.0.9",
      "tmp": "^0.2.4",
      "typeorm": "^0.3.31",
      "undici": "^7.28.0",
      "uri-js": "npm:fast-uri@^3.1.4",
      "uuid@11": "^11.1.1",
      "uuid@13": "^13.0.1",
      "validator": "^13.15.22",
      "vite@6": "^6.4.3",
      "vite@8": "^8.0.16",
      "ws": "^8.21.0",
      "yaml@2": "^2.8.3",
      "yauzl": "^3.2.1"
    },
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@parcel/watcher",
      "@swc/core",
      "bcrypt",
      "esbuild",
      "sharp",
      "sqlite3",
      "unrs-resolver",
      "vue-demi"
    ]
  }
}
